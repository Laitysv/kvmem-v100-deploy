# 复制为 .env 后按需修改：  cp .env.example .env
#
# ⚠️ .env 已在 .gitignore 中，不会被提交；请勿把真实密钥写进 .env.example

# ---- 路径 ----
# KVMem fork 源码目录（容器内挂载为 /src）
KVREPO=/home/user/kvmem-llama.cpp
# 模型 GGUF（只读挂载为容器内 /models/model.gguf）
MODEL=/llama/models/Qwen3.8-27B-GSQ-RCO-IQ3_S-mtp.gguf

# ---- 服务 ----
# 宿主绑定网卡（⚠️ 安全关键）
#   127.0.0.1 = 只本机可访问（默认，推荐）
#   0.0.0.0   = 对局域网开放 —— 注意 /health 免鉴权，会连存活信息一起公开
BIND_IP=127.0.0.1
# 宿主端口
HOST_PORT=8095
CONTAINER_NAME=kvmem-test
# ⚠️ 必须填写！这是服务的 API 鉴权 key。
#    留空 / 不填 → compose 会直接报错退出（这是有意的，避免带着默认值上线）。
#    生成一个：openssl rand -hex 24
API_KEY=

# ---- 上下文 ----
# 逻辑工作区：客户端允许发送的历史长度上限（成本极低，空载仅数百 MiB）
CTX=131072
# 默认生成上限
N_PREDICT=16384

# ---- 内存（本项目最关键的三个）----
# 有效注意力窗口 = 模型实际能"看到"的历史 token 数（不是显存预算！）
#   24576  = 稳（日常）
#   98304  = 均衡（真正的长上下文）
#   36864  = 对齐官方 IQ3 配方
BUDGET=24576
# decode slack：留给本轮新生成 token 的槽位（默认仅 256，本配置调大到 16384）
GEN_RESERVE=16384
# KV 缓存精度（真正的内存杠杆）：
#   q8_0 = 34 KiB/token（默认，更准）
#   q5_0 = 22 KiB/token（推荐，每 token 成本 −35%）
#   q4_0 = 18 KiB/token（更省，精度风险更高）
KV_DTYPE=q5_0

# ---- 投机解码 ----
# none | draft-mtp
# ⚠️ V100（sm_70）上 MTP 是负收益（无 INT8 张量核 → 退回 ALU），建议 none
SPEC_TYPE=draft-mtp
DRAFT_N_MAX=2
MTP_STATE=replay
